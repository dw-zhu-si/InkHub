# InkHub app mode: runtime (default) or evaluation. Evaluation mode stores the
# effective system prompt, injected text context, and tool JSON Schemas in the
# related local conversation. These snapshots can contain manuscript text, so
# enable the mode only on an isolated evaluation machine.
MAIN_VITE_DEEPWRITE_APP_MODE=runtime

# Do not add provider API keys, ModelHub tokens, Apple credentials, OSS access
# keys, relay bearer tokens, or private URLs to Vite-prefixed variables. Vite
# values can be compiled into distributable JavaScript. Provider/ModelHub
# credentials are configured by the application and stored in the OS secure
# store. Optional legacy public-data and OSS integrations are disabled in
# distributed builds and accept runtime-only process variables from a private
# launcher; see their source modules for the exact compatibility variables.
